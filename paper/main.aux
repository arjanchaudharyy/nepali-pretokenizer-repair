\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired differences in held-out Nepali bits per byte (positive: first arm worse), 95\% bootstrap intervals. A: 1\,GB + 1\,GB; B1: the same with an embedding warm-up. The Qwen \textsc  {R2}{} $-$ \textsc  {R1}{} upper bound is $+0.0101$, just above the 0.01 margin. Registered prefix: the model's beginning-of-sequence token where it has one (Llama), as pre-registered; Qwen has none and uses its end-of-text token in both columns. Training separator: the end-of-text token that preceded every document during continued pretraining. $^\dagger $Dominated by the scoring artifact of \S  \ref  {sec:cpt}: the warm-up shifts the beginning-of-sequence embedding.\relax }}{7}{table.caption.31}\protected@file@percent }
\newlabel{tab:prefix}{{2}{7}{Paired differences in held-out Nepali bits per byte (positive: first arm worse), 95\% bootstrap intervals. A: 1\,GB + 1\,GB; B1: the same with an embedding warm-up. The Qwen \RII {} $-$ \RI {} upper bound is $+0.0101$, just above the 0.01 margin. Registered prefix: the model's beginning-of-sequence token where it has one (Llama), as pre-registered; Qwen has none and uses its end-of-text token in both columns. Training separator: the end-of-text token that preceded every document during continued pretraining. $^\dagger $Dominated by the scoring artifact of \S \ref {sec:cpt}: the warm-up shifts the beginning-of-sequence embedding.\relax }{table.caption.31}{}}
