\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces All 24 distinct tokenizers (33 released tokenizers) on FLORES-200 devtest. Aliases: tokenizers whose token ids are identical on every devtest sentence of five languages (Appendix\nobreakspace  {}\ref  {app:audit}). Regex: letters-only, mark-aware, other, or none (no regex pre-tokenizer). ne/en: Nepali/English token premium with 95\% paired-bootstrap interval. Floor: pre-token floor under the tokenizer's own regex, a lower bound on the premium of any merge-based extension (letters-only and mark-aware tokenizers only). Mark-init.: share of Nepali tokens whose first character is a combining mark. Lossless: decoding reproduces the input on 200 Nepali sentences. Arkios is from \citet  {regmi2026arkios}. Hugging Face repositories are listed in the released code.\relax }}{16}{table.caption.43}\protected@file@percent }
\newlabel{tab:audit-full}{{3}{16}{All 24 distinct tokenizers (33 released tokenizers) on FLORES-200 devtest. Aliases: tokenizers whose token ids are identical on every devtest sentence of five languages (Appendix~\ref {app:audit}). Regex: letters-only, mark-aware, other, or none (no regex pre-tokenizer). ne/en: Nepali/English token premium with 95\% paired-bootstrap interval. Floor: pre-token floor under the tokenizer's own regex, a lower bound on the premium of any merge-based extension (letters-only and mark-aware tokenizers only). Mark-init.: share of Nepali tokens whose first character is a combining mark. Lossless: decoding reproduces the input on 200 Nepali sentences. Arkios is from \citet {regmi2026arkios}. Hugging Face repositories are listed in the released code.\relax }{table.caption.43}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Premium = base $\times $ regex factor $\times $ vocabulary factor, on FLORES-200 devtest, for 11 of the 15 letters-only and mark-aware tokenizers in the audit (top: letters-only; bottom: mark-aware). Merge-based extension can only lower the last column, and not below 1.\relax }}{16}{table.caption.45}\protected@file@percent }
\newlabel{tab:decomp}{{4}{16}{Premium = base $\times $ regex factor $\times $ vocabulary factor, on FLORES-200 devtest, for 11 of the 15 letters-only and mark-aware tokenizers in the audit (top: letters-only; bottom: mark-aware). Merge-based extension can only lower the last column, and not below 1.\relax }{table.caption.45}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Language/English premium on FLORES-200 devtest, $K{=}32{,}000$. Marks: share of NFC code points that are combining marks; Amharic and Korean have none (controls). $^\dagger $Thai is written without spaces, so its pre-tokens are long and \textsc  {R1}{} is not yet at its floor. For \textsc  {R1}{}, merge learning stopped below 32{,}000 for Tamil, Telugu, Sinhala, Burmese and Hindi (Llama) (22{,}325--31{,}815 merges), because no further merge was available under the letters-only regex.\relax }}{16}{table.caption.46}\protected@file@percent }
\newlabel{tab:xling}{{5}{16}{Language/English premium on FLORES-200 devtest, $K{=}32{,}000$. Marks: share of NFC code points that are combining marks; Amharic and Korean have none (controls). $^\dagger $Thai is written without spaces, so its pre-tokens are long and \RI {} is not yet at its floor. For \RI {}, merge learning stopped below 32{,}000 for Tamil, Telugu, Sinhala, Burmese and Hindi (Llama) (22{,}325--31{,}815 merges), because no further merge was available under the letters-only regex.\relax }{table.caption.46}{}}
