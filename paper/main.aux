\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Added tokens on the unchanged letters-only regex, FLORES-200 devtest. We register the 31{,}753 of \textsc  {R2}{}'s 32{,}000 new strings that decode to whole Devanagari text (with at most one leading space) as added tokens. Premium: Nepali tokens / English tokens. Mark-initial: share of Nepali tokens that start with a combining mark. The bottom rows describe default matching, which ignores word boundaries: the share of tokens that are added tokens, and the share of added-token matches that start or end inside a word. No sentence without a Devanagari character changes its token ids (191{,}460 FLORES-200 sentences, both models, both matching modes).\relax }}{17}{table.caption.52}\protected@file@percent }
\newlabel{tab:added}{{7}{17}{Added tokens on the unchanged letters-only regex, FLORES-200 devtest. We register the 31{,}753 of \RII {}'s 32{,}000 new strings that decode to whole Devanagari text (with at most one leading space) as added tokens. Premium: Nepali tokens / English tokens. Mark-initial: share of Nepali tokens that start with a combining mark. The bottom rows describe default matching, which ignores word boundaries: the share of tokens that are added tokens, and the share of added-token matches that start or end inside a word. No sentence without a Devanagari character changes its token ids (191{,}460 FLORES-200 sentences, both models, both matching modes).\relax }{table.caption.52}{}}
